# Normalize line endings
* text=auto eol=lf

# Frontend sources
*.js     text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.jsx    text eol=lf
*.css    text eol=lf
*.scss   text eol=lf
*.html   text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf

# Backend sources
*.php    text eol=lf
*.sql    text eol=lf

# Shell and Windows scripts
*.sh     text eol=lf
*.bash   text eol=lf
*.ps1    text eol=crlf
*.bat    text eol=crlf

# Text assets
*.md     text eol=lf
*.txt    text eol=lf

# Images and binaries
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.pdf    binary

# SVG is text (keep diffs readable)
*.svg    text eol=lf

# Lockfiles as text for clearer diffs
package-lock.json text eol=lf


